# =============================================================================
# .gitignore — Files that should NOT be committed to Git
# =============================================================================

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.eggs/
dist/
build/
*.egg
venv/
.env

# Node.js (Serverless Framework)
node_modules/
.serverless/
package-lock.json

# n8n data (contains credentials — NEVER commit these)
n8n_data/

# Docker volumes
postgres_data/

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# AWS credentials (NEVER commit these)
.aws/
credentials

# Video script (local only)
VIDEO_SCRIPT.md

# Vendored Python dependencies (installed locally for deployment)
lambda/csv_processor/psycopg2/
lambda/csv_processor/*.dist-info/
*.dist-info/
